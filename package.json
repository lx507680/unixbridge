{
  "name": "unixbridge",
  "version": "0.1.0",
  "private": true,
  "author": "unixbridge contributors",
  "description": "A Warp-like Windows terminal with explicit Unix command semantics.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "package": "npm run package:mac",
    "package:mac": "npm run build && electron-builder --mac dmg --config.electronDist=node_modules/electron/dist",
    "package:win": "npm run build && electron-builder --win nsis --x64 --config.npmRebuild=false",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "string-width": "^5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "dev.unixbridge.terminal",
    "productName": "unixbridge",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
